# คัดลอกเป็น app/.env.local แล้วเติมค่าจริงเอง — ห้ามส่งค่าจริงในแชท / ห้าม commit
# Webull OpenAPI (ขอที่ https://developer.webull.co.th — region th)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION_ID=th
WEBULL_ENVIRONMENT=uat            # uat = sandbox (ค่าเริ่มต้น) · prod = เงินจริง (ต้นเปิดเองเท่านั้น)
WEBULL_MAX_ORDER_NOTIONAL_USD=500 # เพดานมูลค่าต่อคำสั่ง (ปรับตามเฟส)
WEBULL_MAX_ORDER_QUANTITY=100
WEBULL_SYMBOL_WHITELIST=          # เช่น VOO,AAPL,MSFT — ว่าง = ยังไม่อนุญาตส่งคำสั่ง

# Supabase (โปรเจกต์ aqklpnjzgtpqotxebthn)
NEXT_PUBLIC_SUPABASE_URL=https://aqklpnjzgtpqotxebthn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # ฝั่งเซิร์ฟเวอร์เท่านั้น

# ข้อมูลตลาดชั้น 2 (ทางเลือก — งานวิจัย)
FINNHUB_API_KEY=
FMP_API_KEY=

# ---- app runtime (Vercel env / app/.env.local) ----
UPVERSE_OWNER_PASSPHRASE=          # รหัสผ่านเจ้าของ (ว่าง = โหมด dev เปิดให้เข้า — ห้ามว่างบน production)
UPVERSE_SESSION_SECRET=            # สุ่มยาว ๆ (openssl rand -hex 32)
UPVERSE_MASTER_KEY=                # 32 ไบต์ hex (openssl rand -hex 32) — เข้ารหัสกุญแจ Webull ที่เก็บ
TRADING_ENABLED=false              # kill switch ชั้น env (true เฉพาะเมื่อผ่านประตูเฟส 2)
CRON_SECRET=                       # ให้ Vercel Cron / GitHub Actions เรียกสแกนกลางคืน
UPVERSE_OWNER_ID=owner             # คีย์แถวใน upverse_state
UPVERSE_USE_SUPABASE=0            # ในเครื่อง: 1 = ใช้ Supabase จริงแทนไฟล์ (ระวังปนข้อมูล production)
